{
  "name": "aic-sentinel",
  "version": "1.0.0",
  "description": "Web-based PingOne AIC log viewer with live tailing, historical search, and noise filtering",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "stop": "lsof -ti:${PORT:-3000} | xargs kill 2>/dev/null || echo 'No process found on port ${PORT:-3000}'",
    "dev": "node --watch server.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:unit": "node --test tests/unit/*.test.js"
  },
  "author": "Mark Nienaber",
  "keywords": [
    "pingone",
    "aic",
    "forgerock",
    "logs",
    "monitoring",
    "debug"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@napi-rs/keyring": "2.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "alpinejs": "3.14.8",
    "tailwindcss": "3.4.17"
  }
}
