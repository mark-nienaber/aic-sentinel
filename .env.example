# AIC Sentinel Configuration
# This file is optional. Copy it to .env to change the defaults below.

# Server port. The server always listens on 127.0.0.1.
PORT=3000

# Polling frequency in seconds (default: 10)
POLL_FREQUENCY=10

# Maximum log buffer size in the browser (default: 5000)
MAX_LOG_BUFFER=5000

# The values below are only used by the end to end tests (npm run test:e2e).
# The app itself does not read them. Enter tenant credentials in the browser,
# where they are saved to your operating system keychain.
TENANT_URL=https://your-tenant.forgeblocks.com
API_KEY_ID=your-api-key-id-here
API_KEY_SECRET=your-api-key-secret-here
TEST_USER=your-test-username
TEST_PASS=your-test-password
